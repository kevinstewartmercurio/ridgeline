<script>
  const init = () => {
    const footer = document.querySelector("footer");

    if (footer instanceof HTMLElement) {
      // `astro:page-load` runs this again after every navigation, so the
      // listener below is dropped as the footer it belongs to goes away.
      const controller = new AbortController();

      document.addEventListener("astro:before-swap", () => controller.abort(), {
        once: true,
      });

      // A footer taller than the viewport can't be stuck to the bottom: the
      // top of it would scroll out of reach above the fold.
      const updateSticky = () => {
        // Measured unstuck, so the height doesn't depend on the current state.
        footer.classList.remove("sticky", "bottom-0");

        if (footer.getBoundingClientRect().height <= window.innerHeight) {
          footer.classList.add("sticky", "bottom-0");
        }
      };

      window.addEventListener("resize", updateSticky, {
        signal: controller.signal,
      });

      // The markup ships sticky, so the first load needs this too.
      updateSticky();
    }
  };

  document.addEventListener("astro:page-load", init);
</script>
