<section class="bg-pine px-5 pt-10 pb-6 sm:px-8 lg:px-10 lg:pb-10">
  <div class="mx-auto w-full max-w-344">
    <div
      class="border-alabaster/15 w-full space-y-8 gap-x-8 border-t pt-10 md:flex md:pt-14 lg:gap-x-12 xl:gap-x-16"
    >
      <div class="space-y-4 md:w-1/2 lg:space-y-6">
        <h2
          class="text-alabaster font-newsreader text-5xl/[85%] font-light md:text-6xl/[85%] lg:text-7xl/[85%] xl:text-8xl/[85%]"
        >
          Start a conversation
        </h2>
        <p
          class="font-instrument text-alabaster max-w-md text-sm opacity-65 md:text-base xl:max-w-124 xl:text-lg"
        >
          Tell us the project type, roughly where it sits, and when you would
          like to be living in it. A partner replies to every enquiry.
        </p>
      </div>
      <div class="max-w-lg pb-10 md:w-1/2 md:max-w-none">
        <form>
          {
            [
              { id: "name", type: "text", label: "Name" },
              { id: "email", type: "email", label: "Email Address" },
              { id: "phone", type: "tel", label: "Phone Number" },
            ].map((inputObj, idx) => (
              <div
                class:list={[
                  "border-alabaster/14 relative",
                  !idx ? "border-y" : "border-b",
                ]}
              >
                <input
                  id={inputObj.id}
                  type={inputObj.type}
                  placeholder={inputObj.label}
                  required={inputObj.id !== "phone"}
                  class="peer text-alabaster/65 font-newsreader ring-alabaster w-full px-2.5 pt-5 pb-2.5 text-lg placeholder-transparent outline-none focus:ring-1"
                />
                <label
                  for={inputObj.id}
                  class="font-jetbrains text-alabaster/65 absolute top-2.75 left-2.5 -translate-y-1/2 text-[0.5625rem] uppercase duration-300 peer-placeholder-shown:top-1/2 peer-placeholder-shown:text-xs peer-focus:top-2.75 peer-focus:text-[0.5625rem]"
                >
                  {inputObj.label}
                </label>
              </div>
            ))
          }
          <div class="border-alabaster/14 relative border-b">
            <textarea
              id="message"
              placeholder="Message"
              rows="6"
              required
              class="peer text-alabaster/65 font-newsreader ring-alabaster w-full resize-none px-2.5 py-4 text-lg placeholder-transparent outline-none focus:ring-1"
            ></textarea>
            <label
              for="message"
              class="font-jetbrains text-alabaster/65 absolute top-2.75 left-2.5 -translate-y-1/2 text-[0.5625rem] uppercase duration-300 peer-placeholder-shown:top-7.5 peer-placeholder-shown:text-xs peer-focus:top-2.75 peer-focus:text-[0.5625rem]"
            >
              Message
            </label>
          </div>
          <button
            type="submit"
            class="text-pine bg-alabaster font-jetbrains mt-6 cursor-pointer px-4 py-3 text-xs uppercase lg:px-5 lg:py-4"
            >Send Enquiry</button
          >
        </form>
      </div>
    </div>
    <div
      class="font-jetbrains text-alabaster/65 text-2xs border-alabaster/15 flex w-full flex-col gap-y-8 border-t py-6 uppercase sm:flex-row sm:justify-between md:grid md:grid-cols-3"
    >
      <div>
        <a href="/" class="hover:underline focus:underline">
          Ridgeline Architecture Studio
        </a>
        <br />
        © 2026 Ridgeline Architecture Studio
      </div>
      <div class="flex sm:justify-center">
        <div>
          <a href="/" class="hover:underline focus:underline">
            (360) 555-0148
          </a>
          <br /><br />

          <a href="/" class="hover:underline focus:underline">
            1420 Alder Ridge Lane, Suite 300 <br />
            Bellingham, WA 98825
          </a>
        </div>
      </div>
      <div>
        <div
          class="flex gap-x-4 gap-y-1 sm:flex-col sm:items-end md:flex-row md:justify-end"
        >
          {
            ["Instagram", "LinkedIn", "Contact"].map((s) => (
              <a href="/" class="hover:underline focus:underline">
                {s}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
