---
import { Image } from "astro:assets";

import stack1Image from "../images/homepage/stack-1.png";
import stack2Image from "../images/homepage/stack-2.png";
import stack3Image from "../images/homepage/stack-3.png";
import stack4Image from "../images/homepage/stack-4.png";
---

<section class="bg-pine">
  <div class="relative w-full">
    <div id="img-1-container" class="sticky top-0 h-screen w-full">
      <div class="relative h-full w-full">
        <Image
          src={stack1Image}
          alt=""
          class="h-full w-full rounded-3xl object-cover"
        />
        <div
          class="absolute bottom-40 left-1/2 w-full -translate-x-1/2 px-5 sm:px-8 lg:px-10"
        >
          <div class="mx-auto w-full max-w-344">
            <span
              class="font-jetbrains text-alabaster mb-3 block text-sm uppercase"
              >Our Position</span
            >
            <p
              class="font-instrument text-alabaster max-w-2xl text-3xl font-light"
            >
              A home should be designed around how a family actually lives, not
              around a template.
            </p>
          </div>
        </div>
      </div>
    </div>
    {
      [
        {
          img: {
            src: stack2Image,
            alt: "",
          },
          span: "One Roof",
          p: "Design and construction oversight stay in-house from day one. Fewer handoffs, shorter timelines, fewer cost overruns.",
        },
        {
          img: {
            src: stack3Image,
            alt: "",
          },
          span: "Small Roster",
          p: "Eight to ten active projects at a time, so every home gets partner-level attention rather than a junior team.",
        },
        {
          img: {
            src: stack4Image,
            alt: "",
          },
          span: "Architect First",
          p: "Every engagement opens with an architect on the site, reading the land before anything is drawn.",
        },
      ].map((card) => (
        <div class="sticky top-0 h-screen w-full">
          <div class="relative h-full w-full">
            <Image
              src={card.img.src}
              alt={card.img.alt}
              class="h-full w-full object-cover"
            />
            <div class="absolute bottom-40 left-1/2 w-full -translate-x-1/2 px-5 sm:px-8 lg:px-10">
              <div class="mx-auto w-full max-w-344">
                <span class="font-jetbrains text-alabaster mb-3 block text-sm uppercase">
                  {card.span}
                </span>
                <p class="font-instrument text-alabaster max-w-3xl text-2xl font-light">
                  {card.p}
                </p>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { animate, scroll } from "motion";

  const image1Container = document.getElementById("img-1-container");
  const image1 = document.querySelector("#img-1-container img");

  if (
    image1Container instanceof HTMLDivElement &&
    image1 instanceof HTMLImageElement
  ) {
    scroll(animate(image1Container, { padding: ["40px", "0px"] }), {
      target: image1Container,
      offset: ["0 1", "0 0"],
    });
    scroll(animate(image1, { borderRadius: ["24px", "0px"] }), {
      target: image1Container,
      offset: ["0 1", "0 0"],
    });
  }
</script>
