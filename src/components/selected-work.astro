---
import { Image } from "astro:assets";

import HeroImage from "../images/homepage/hero.png";

const work = [
  {
    title: "Larch House",
    location: "Methow Valley, WA",
    type: "New Build",
    year: 2025,
    img: {
      src: HeroImage,
      alt: "",
    },
  },
  {
    title: "Fern Hollow",
    location: "Portland, OR",
    type: "Infill",
    year: 2024,
    img: {
      src: HeroImage,
      alt: "",
    },
  },
  {
    title: "Cutbank Residence",
    location: "Bainbridge Island, WA",
    type: "New Build",
    year: 2024,
    img: {
      src: HeroImage,
      alt: "",
    },
  },
  {
    title: "The Ledger House",
    location: "Bend, OR",
    type: "Renovation",
    year: 2023,
    img: {
      src: HeroImage,
      alt: "",
    },
  },
  {
    title: "Skagit Barn",
    location: "Skagit Valley, WA",
    type: "Addition",
    year: 2023,
    img: {
      src: HeroImage,
      alt: "",
    },
  },
];
---

<section id="selected-work-section" class="bg-alabaster px-5 py-20 sm:px-9">
  <div class="mx-auto w-full max-w-344">
    <div class="text-ink">
      <h2
        class="text-pine font-newsreader flex w-full justify-between text-8xl font-light"
      >
        <span>Selected</span>
        <span>Work</span>
      </h2>
      <div>
        {
          work.map((project, idx) => (
            <a
              href="/"
              class:list={[
                "group project-link font-jetbrains text-ink/65 relative text-sm uppercase",
              ]}
            >
              <div class="relative grid w-full grid-cols-[50px_2.25fr_1.5fr_1fr_1fr_90px] items-center gap-x-5 py-5 pl-1.5">
                {!idx && (
                  <hr class="border-ink/12 absolute top-0 left-0 h-px w-full" />
                )}
                <span class="block">{String(idx + 1).padStart(2, "0")}</span>
                <h3 class="text-ink font-newsreader text-4xl font-light normal-case">
                  {project.title}
                </h3>
                <span class="block">{project.location}</span>
                <span class="block">{project.type}</span>
                <span class="block">{project.year}</span>
                <Image
                  src={project.img.src}
                  alt={project.img.alt}
                  class="h-14 w-22.5 object-cover"
                />
                <hr class="border-ink/12 absolute bottom-0 left-0 h-px w-full" />
              </div>

              <div class="bg-pine project-selector text-alabaster absolute top-0 left-0 h-full w-full [clip-path:inset(0%_0%_100%_0%)]">
                <div class="relative grid w-full grid-cols-[50px_2.25fr_1.5fr_1fr_1fr_90px] items-center gap-x-5 py-5 pl-1.5">
                  {!idx && (
                    <hr class="border-pine absolute top-0 left-0 h-px w-full" />
                  )}
                  <span class="block">{String(idx + 1).padStart(2, "0")}</span>
                  <h3 class="text-alabaster font-newsreader text-4xl font-light normal-case">
                    {project.title}
                  </h3>
                  <span class="block">{project.location}</span>
                  <span class="block">{project.type}</span>
                  <span class="block">{project.year}</span>
                  <Image
                    src={project.img.src}
                    alt={project.img.alt}
                    class="h-14 w-22.5 object-cover"
                  />
                  <hr class="border-pine absolute bottom-0 left-0 h-px w-full" />
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  const selectedWorkSection = document.getElementById("selected-work-section");
  const projectLinks = document.querySelectorAll(".project-link");
  const projectSelectors = document.querySelectorAll(".project-selector");

  if (selectedWorkSection instanceof HTMLElement) {
    let mouseMovingDown = true;
    let prevY = 0;

    selectedWorkSection.addEventListener("mousemove", (e) => {
      mouseMovingDown = e.y > prevY;
      prevY = e.y;
    });

    projectLinks.forEach((project, idx) => {
      if (project instanceof HTMLAnchorElement) {
        project.addEventListener("mouseenter", () => {
          if (projectSelectors[idx] instanceof HTMLDivElement) {
            animate(
              projectSelectors[idx],
              {
                clipPath: [
                  mouseMovingDown
                    ? "inset(0% 0% 100% 0%)"
                    : "inset(100% 0% 0% 0%)",
                  "inset(0% 0% 0% 0%)",
                ],
              },
              {
                duration: 0.3,
              },
            );
          }
        });

        project.addEventListener("mouseleave", () => {
          if (projectSelectors[idx] instanceof HTMLDivElement) {
            animate(
              projectSelectors[idx],
              {
                clipPath: [
                  "inset(0% 0% 0% 0%)",
                  mouseMovingDown
                    ? "inset(100% 0% 0% 0%)"
                    : "inset(0% 0% 100% 0%)",
                ],
              },
              { duration: 0.3 },
            );
          }
        });
      }
    });
  }
</script>
