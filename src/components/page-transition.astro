---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import Logo from "./logo.astro";

// The photographs only ever appear inside the 96–144px square the logo sits
// in, so they are cropped square and small here rather than at their hero
// sizes: the reveal has to start moments after a link is clicked. The size
// leaves enough for a 2x screen at the larger of those two widths.
const PHOTOGRAPH_SIZE = 384;

// How many photographs one run shows. The script fills every slot, so this
// number alone decides the length of the run.
const SLOTS = 8;

// Everything photographed for the site, so no two transitions look alike. The
// studio portraits are left out: faces flickering past read as people rather
// than as places.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../images/**/*.{png,jpg,jpeg}",
  { eager: true },
);

const pool = await Promise.all(
  Object.entries(files)
    .filter(
      ([path]) => !path.includes("/studio/") || path.endsWith("/hero.jpg"),
    )
    .map(([, file]) =>
      getImage({
        src: file.default,
        width: PHOTOGRAPH_SIZE,
        height: PHOTOGRAPH_SIZE,
        fit: "cover",
        position: "center",
        format: "webp",
      }),
    ),
);
---

{
  /* Resting styles are inline rather than utilities: Tailwind's translate
     utilities compile to the `translate` property, which composes with the
     `transform` Motion writes instead of replacing it, and the clip-path
     keyframes need to match the exact strings the script animates between.

     The background is a sibling of the logo rather than its parent so that it
     can be scaled unevenly into the nav square without stretching the logo.

     The photographs sit under the logo in the same square. The logo carries a
     pine backing of its own so that wiping it over the last photograph shows
     the same negative space as always through the mark, rather than a window
     onto the photograph underneath. */
}

<div
  id="page-transition"
  transition:persist="page-transition"
  aria-hidden="true"
  class="pointer-events-none invisible fixed inset-0 z-50 flex items-center justify-center will-change-transform"
  style="transform: translateY(-100%)"
>
  <div
    id="page-transition-background"
    class="bg-pine absolute inset-0 origin-top-left will-change-transform"
  >
  </div>
  <div class="relative size-36 md:size-48">
    <div
      id="page-transition-photographs"
      class="absolute inset-0"
      data-pool={JSON.stringify(pool.map((image) => image.src))}
    >
      {
        /* Decorative: the photographs flash past behind the curtain, which is
           hidden from assistive tech as a whole, so the empty alt is
           deliberate. */
        Array.from({ length: SLOTS }, () => (
          <img
            alt=""
            fetchpriority="low"
            class="absolute inset-0 size-full object-cover"
            style="clip-path: inset(0% 0% 100% 0%)"
          />
        ))
      }
    </div>
    <div
      id="page-transition-logo"
      class="bg-pine absolute inset-0 will-change-transform"
      style="clip-path: inset(0% 0% 100% 0%)"
    >
      <Logo class="fill-alabaster size-full" />
    </div>
  </div>
</div>

<style is:global>
  /* The curtain covers the viewport for the whole swap, so the browser's
     default root cross-fade would only delay the reveal. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  /* The curtain already down on arrival, for a visit that opens with the
     intro. Only the head script in `Layout.astro` sets the mark, and the
     script below lifts it as soon as it has copied this state into inline
     styles, so the `!important` only has to beat the resting inline transform
     for those first few frames. The reduced-motion query repeats the head
     script's own check, so the curtain can never cover a page that has no way
     to animate it away. */
  @media not (prefers-reduced-motion: reduce) {
    html[data-intro] #page-transition {
      visibility: visible;
      pointer-events: auto;
      transform: none !important;
    }
  }
</style>

<script>
  import { animate, type AnimationPlaybackControls } from "motion";

  const COVER_DURATION = 0.5;
  // Every photograph in a run shares this budget.
  const PHOTOGRAPH_SEQUENCE_DURATION = 1.5;
  // Each photograph is revealed for this fraction of the time the one before
  // it took, so the sequence tightens as it goes. Eight of them divide the
  // budget finely enough that the run has to accelerate gently to keep its
  // tail on screen long enough to register.
  const ACCELERATION = 0.85;
  // The logo's wipe is a touch slower than the last photograph's, which lets
  // the run land on it instead of running past it.
  const LOGO_REVEAL_DURATION = 0.25;
  const SHRINK_DURATION = 0.8;
  // Used when there is no nav logo to shrink into.
  const SLIDE_OUT_DURATION = 0.25;
  // How far into the shrink the page underneath has enough of itself back to
  // begin its own entrance. The curtain leaves the far corner first and takes
  // its time landing in the nav, so waiting for the whole shrink would leave
  // the page sitting still in plain sight.
  const HANDOVER_POINT = 0.35;
  // How long the logo stays centered after the new page is ready.
  const HOLD_DURATION = 0.5;
  // How long the run will wait for a photograph that was not already in the
  // cache before starting without it.
  const DECODE_TIMEOUT = 0.3;
  // The intro's photographs start loading with the page rather than a whole
  // navigation ahead, so they are given longer.
  const INTRO_DECODE_TIMEOUT = 1;
  const EASE = [0.76, 0, 0.24, 1] as const;
  // The photographs hand off to one another, so each wipe leads with its
  // speed rather than easing in from a stop.
  const PHOTOGRAPH_EASE = [0.33, 1, 0.68, 1] as const;

  // The shrink animates whole `transform` strings rather than clip-path or
  // Motion's `x`/`scale` shorthands: Motion hands full transforms to the
  // browser, which runs them on the compositor, so the shrink stays smooth
  // while the new page's scripts and images load. Clip-path had to repaint the
  // whole viewport every frame and stuttered. Both keyframes share the same
  // function list so the browser interpolates each value linearly.
  const IDENTITY = "translate(0px, 0px) scale(1, 1)";
  const HIDDEN = "inset(0% 0% 100% 0%)";
  const SHOWN = "inset(0% 0% 0% 0%)";

  const curtain = document.getElementById("page-transition");
  const background = document.getElementById("page-transition-background");
  const photographs = document.getElementById("page-transition-photographs");
  const logo = document.getElementById("page-transition-logo");
  const prefersReducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

  const timing = (seconds: number) =>
    prefersReducedMotion.matches ? 0 : seconds;

  const wait = (seconds: number) =>
    new Promise((resolve) => setTimeout(resolve, timing(seconds) * 1000));

  // Unlike `wait`, this one is a deadline rather than a beat, so reduced
  // motion must not collapse it to nothing.
  const deadline = (seconds: number) =>
    new Promise((resolve) => setTimeout(resolve, seconds * 1000));

  if (
    curtain instanceof HTMLDivElement &&
    background instanceof HTMLDivElement &&
    photographs instanceof HTMLDivElement &&
    logo instanceof HTMLDivElement
  ) {
    const pool: string[] = JSON.parse(photographs.dataset.pool ?? "[]");
    const slots = Array.from(photographs.querySelectorAll("img"));

    // Whether the curtain is currently down, so that a navigation started
    // while another one is still running does not replay the slide in.
    let covered = false;
    // The logo reveal in progress or done, shared so that a navigation started
    // during the intro waits on the intro's reveal rather than skipping it.
    let revealing: Promise<void> | null = null;
    // `astro:page-load` also fires on the initial load, where there is
    // nothing to reveal.
    let navigating = false;
    // The shrink in progress, so that a navigation started mid-shrink can
    // grow the curtain back out instead of snapping it off screen.
    let shrinking: AnimationPlaybackControls[] = [];
    // The slots holding the next run's photographs. They are filled a whole
    // navigation ahead, at a low fetch priority, so the reveal never waits on
    // the network and the loading never competes with the page's own images.
    let chosen: HTMLImageElement[] = [];

    const choose = () => {
      if (prefersReducedMotion.matches || !pool.length) {
        chosen = [];
        return;
      }

      // Drawn without replacement so a run never shows the same photograph
      // twice.
      const remaining = [...pool];

      chosen = slots.slice(0, Math.min(slots.length, pool.length));
      chosen.forEach((slot) => {
        const [src] = remaining.splice(
          Math.floor(Math.random() * remaining.length),
          1,
        );
        slot.src = src;
      });
    };

    // The curtain is persisted across the swap, so this mark travels with it
    // into the page being opened, where `reveal.astro` reads it and holds that
    // page's entrance back until the curtain is out of its way.
    const handOver = () => {
      if (!curtain.hasAttribute("data-covering")) return;

      curtain.removeAttribute("data-covering");
      document.dispatchEvent(new Event("transition:handover"));
    };

    const cover = async () => {
      if (covered) return;
      covered = true;

      curtain.classList.remove("pointer-events-none");

      if (shrinking.length) {
        shrinking.forEach((animation) => animation.stop());
        shrinking = [];

        const options = { duration: timing(SHRINK_DURATION), ease: EASE };
        await Promise.all([
          animate(background, { transform: IDENTITY }, options),
          animate(logo, { transform: IDENTITY }, options),
        ]);
      } else {
        curtain.classList.remove("invisible");
        await animate(
          curtain,
          { y: ["-100%", "0%"] },
          { duration: timing(COVER_DURATION), ease: EASE },
        );
      }

      // Lets the nav rearrange itself while nothing underneath is visible.
      document.dispatchEvent(new Event("page-transition:covered"));
    };

    // Wipes a handful of photographs through the square, each faster than the
    // last, and lands on the logo.
    const revealLogo = (decodeTimeout = DECODE_TIMEOUT) =>
      (revealing ??= runPhotographs(decodeTimeout));

    const runPhotographs = async (decodeTimeout: number) => {
      const run = chosen;

      if (run.length) {
        await Promise.race([
          Promise.all(run.map((slot) => slot.decode().catch(() => {}))),
          deadline(decodeTimeout),
        ]);
      }

      // The durations are a geometric run summing to the budget, so adding a
      // fifth photograph tightens the whole sequence rather than lengthening
      // it.
      const ratios = run.map((_, index) => ACCELERATION ** index);
      const total = ratios.reduce((sum, ratio) => sum + ratio, 0);

      for (const [index, slot] of run.entries()) {
        await animate(
          slot,
          { clipPath: [HIDDEN, SHOWN] },
          {
            duration: timing(
              (PHOTOGRAPH_SEQUENCE_DURATION * ratios[index]) / total,
            ),
            ease: PHOTOGRAPH_EASE,
          },
        );
      }

      await animate(
        logo,
        { clipPath: [HIDDEN, SHOWN] },
        { duration: timing(LOGO_REVEAL_DURATION), ease: EASE },
      );

      // The logo's own backing now covers the square, so dropping the
      // photographs before the shrink carries them off is invisible.
      photographs.style.visibility = "hidden";
    };

    // Puts the curtain back above the viewport, hidden, ready for the next
    // navigation.
    const reset = () => {
      curtain.classList.add("invisible", "pointer-events-none");
      revealing = null;

      animate(curtain, { y: "-100%" }, { duration: 0 });
      animate(background, { transform: IDENTITY }, { duration: 0 });
      animate(logo, { transform: IDENTITY, clipPath: HIDDEN }, { duration: 0 });
      photographs.style.visibility = "";
      slots.forEach((slot) =>
        animate(slot, { clipPath: HIDDEN }, { duration: 0 }),
      );

      // Loads the next run's photographs now, while nothing is moving.
      choose();

      // Only left to do here if the curtain was taken off screen some way
      // other than the reveal below, which hands over partway through.
      handOver();

      document.dispatchEvent(new Event("page-transition:finished"));
    };

    const reveal = async () => {
      if (!covered) return;
      covered = false;

      curtain.classList.add("pointer-events-none");

      const square = document.getElementById("nav-logo");
      const mark = square?.querySelector("svg");

      if (!square || !mark) {
        await animate(
          curtain,
          { y: ["0%", "-100%"] },
          { duration: timing(SLIDE_OUT_DURATION), ease: EASE },
        );
        handOver();
        if (!covered) reset();
        return;
      }

      const bounds = curtain.getBoundingClientRect();
      const squareBounds = square.getBoundingClientRect();
      const markBounds = mark.getBoundingClientRect();
      const logoBounds = logo.getBoundingClientRect();

      // The background scales from its top-left corner.
      const backgroundX = squareBounds.left - bounds.left;
      const backgroundY = squareBounds.top - bounds.top;
      const backgroundScaleX = squareBounds.width / bounds.width;
      const backgroundScaleY = squareBounds.height / bounds.height;

      // The logo scales from its center.
      const logoX =
        markBounds.left +
        markBounds.width / 2 -
        (logoBounds.left + logoBounds.width / 2);
      const logoY =
        markBounds.top +
        markBounds.height / 2 -
        (logoBounds.top + logoBounds.height / 2);
      const logoScale = markBounds.width / logoBounds.width;

      const options = { duration: timing(SHRINK_DURATION), ease: EASE };
      const animations = [
        animate(
          background,
          {
            transform: [
              IDENTITY,
              `translate(${backgroundX}px, ${backgroundY}px) scale(${backgroundScaleX}, ${backgroundScaleY})`,
            ],
          },
          options,
        ),
        animate(
          logo,
          {
            transform: [
              IDENTITY,
              `translate(${logoX}px, ${logoY}px) scale(${logoScale}, ${logoScale})`,
            ],
          },
          options,
        ),
      ];
      shrinking = animations;

      setTimeout(
        () => {
          // A new navigation covered the page again while the shrink ran.
          if (shrinking === animations) handOver();
        },
        timing(SHRINK_DURATION) * HANDOVER_POINT * 1000,
      );

      await Promise.all(animations);
      // A new navigation took over mid-shrink.
      if (shrinking !== animations) return;
      shrinking = [];

      // The curtain now sits exactly over the nav logo, so hiding it is
      // invisible.
      reset();
    };

    // Plays the second half of a navigation over a visit's first page: the
    // curtain arrives already down (see the stylesheet above), so it goes
    // straight into the photographs, the logo and the shrink into the nav.
    const intro = async () => {
      covered = true;

      // Takes the covered state over from the stylesheet before lifting the
      // mark it hangs on, so the curtain never leaves the viewport between
      // the two.
      curtain.classList.remove("invisible", "pointer-events-none");
      curtain.style.transform = "translateY(0%)";
      curtain.setAttribute("data-covering", "");
      document.documentElement.removeAttribute("data-intro");
      document.dispatchEvent(new Event("page-transition:covered"));

      await revealLogo(INTRO_DECODE_TIMEOUT);
      await wait(HOLD_DURATION);

      // A navigation started during the intro reveals its own page once it
      // has loaded.
      if (!navigating) reveal();
    };

    choose();

    if (document.documentElement.hasAttribute("data-intro")) intro();

    document.addEventListener("astro:before-preparation", (e) => {
      // These links bring their own transition, which takes priority.
      if (e.sourceElement?.closest("[data-project-transition]")) return;

      const loadNewDocument = e.loader;
      navigating = true;
      curtain.setAttribute("data-covering", "");

      e.loader = async () => {
        await cover();
        await Promise.all([revealLogo(), loadNewDocument()]);
        await wait(HOLD_DURATION);
      };
    });

    document.addEventListener("astro:page-load", () => {
      if (!navigating) return;
      navigating = false;

      reveal();
    });
  }
</script>
