---
import Logo from "../logo.astro";
---

<section
  class="bg-alabaster xs:py-14 relative z-10 px-5 py-14 sm:px-8 lg:px-10 lg:py-20 xl:py-24"
>
  <div class="mx-auto w-full max-w-344">
    <div data-reveal-group class="w-full space-y-5 lg:space-y-6 xl:space-y-8">
      <p
        class="font-newsreader text-ink text-2xl font-extralight md:text-3xl lg:text-4xl xl:text-5xl"
      >
        What you're looking for may still be under construction.
      </p>
      <p class="font-instrument text-ink/65 md:text-lg lg:text-xl xl:text-2xl">
        Head on back to the
        <a
          href="/"
          class="bg-pine text-alabaster xs:py-1 ml-1 inline-flex items-center gap-x-2 px-2 py-0.5 xl:py-1.5"
        >
          <Logo class="fill-alabaster xs:size-5 size-4 xl:size-6" />
          <span>Homepage</span>
        </a>
      </p>
    </div>
  </div>
</section>
