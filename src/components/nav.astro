---
import Logo from "./logo.astro";
import Arrow from "./arrow.astro";
import Hamburger from "./hamburger.astro";
---

{
  /* `#nav-logo` is the square the page transition shrinks into, so its size
     and position are measured at runtime rather than duplicated there.

     `#nav-left-panel` opens out of the logo while the page is scrolled to the top.
     It is revealed with clip-path rather than animated width so its contents
     stay put instead of reflowing as it opens. Clip-path also limits clicks to
     the visible part of the panel, so a closed panel leaves only the logo
     clickable. `#nav-right-panel` slides off to the right while the page is
     scrolled, and `#nav-hamburger-btn` slides in from the right in its place.
     Below the `md` breakpoint the right panel is never shown and the hamburger
     always is.

     The whole nav slides up out of the viewport while scrolling down and comes
     back on scrolling up.

     The hamburger opens `#nav-menu`, a panel in the bottom right over a scrim,
     with the page behind it locked. Both sit outside `<nav>`, which is
     translated as it hides and would otherwise drag them along with it.

     The nav spans the page width, so it ignores clicks to keep the content
     beneath it clickable; anything interactive inside needs
     `pointer-events-auto`. */
}

<nav
  id="nav"
  transition:persist="nav"
  class="pointer-events-none fixed top-5 left-0 z-40 w-full transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] data-hidden:translate-y-[calc(-100%---spacing(5))] motion-reduce:transition-none"
>
  <div class="w-full px-5 sm:px-8 lg:px-10">
    <div class="mx-auto flex w-full max-w-344 justify-between">
      <a
        href="/"
        id="nav-home"
        aria-label="Ridgeline Architecture Studio home"
        class="flex"
      >
        <div
          id="nav-logo"
          class="bg-pine pointer-events-auto flex size-14 shrink-0 items-center justify-center px-3 py-2 lg:size-16"
        >
          <Logo class="fill-alabaster h-full w-full" aria-hidden="true" />
        </div>
        <div
          id="nav-left-panel"
          data-open
          class="text-alabaster bg-pine pointer-events-auto flex h-14 items-center pr-3 transition-[clip-path] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] [clip-path:inset(0_100%_0_0)] data-open:[clip-path:inset(0)] motion-reduce:transition-none lg:h-16 lg:pr-4"
        >
          <div>
            <span
              class="font-newsreader block text-2xl/[110%] font-light lg:text-3xl"
              >Ridgeline</span
            >
            <span
              class="font-jetbrains text-2xs/[1] block uppercase lg:text-xs/[1]"
              >Architecture Studio</span
            >
          </div>
        </div>
      </a>
      <div class="relative overflow-clip max-md:w-12">
        <div
          id="nav-right-panel"
          data-open
          class="font-jetbrains text-alabaster peer pointer-events-auto flex h-14 translate-x-full items-center gap-x-7 text-xs uppercase transition-[translate] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] data-open:translate-x-0 motion-reduce:transition-none max-md:hidden lg:h-16"
        >
          <a href="/project/larch-house" class="uline after:bg-alabaster"
            >Projects</a
          >
          <a href="/studio" class="uline after:bg-alabaster">Studio</a>
          <button class="group flex h-12 cursor-pointer">
            <div class="bg-alabaster text-ink flex items-center px-3 uppercase">
              Start a Conversation
            </div>
            <div class="bg-pine flex items-center px-3">
              <Arrow class="fill-alabaster w-11" />
            </div>
          </button>
        </div>
        <button
          id="nav-hamburger-btn"
          inert
          aria-expanded="false"
          class="bg-alabaster pointer-events-auto absolute top-1/2 right-0 flex size-12 -translate-y-1/2 cursor-pointer items-center justify-center transition-[translate] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none md:peer-data-open:translate-x-full"
        >
          <Hamburger class="scale-80 overflow-visible" />
        </button>
      </div>
    </div>
  </div>
</nav>

<div
  id="nav-scrim"
  transition:persist="nav-scrim"
  class="bg-ink/80 invisible fixed inset-0 z-30 opacity-0 [backdrop-filter:blur(2px)] transition-[opacity,visibility] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] data-open:visible data-open:opacity-100 motion-reduce:transition-none"
>
</div>

{
  /* The wrapper lines the panel up with the nav's right edge, and the column
    inside it clips the panel so that it is out of sight while closed rather
    than showing in the gutter beside it. */
}
<div
  id="nav-menu"
  transition:persist="nav-menu"
  inert
  class="group pointer-events-none fixed inset-x-0 bottom-5 z-45 px-5 sm:px-8 lg:px-10"
>
  <div class="mx-auto flex w-full max-w-344 justify-end overflow-clip">
    <div
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      class="bg-alabaster pointer-events-auto max-h-[calc(100dvh-2.5rem)] w-72 max-w-full translate-x-full overflow-y-auto p-4 transition-[translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-open:translate-x-0 motion-reduce:transition-none lg:w-88 lg:p-5"
    >
      <a href="/" class="mb-5 flex items-center gap-x-3 lg:mb-6">
        <Logo class="fill-pine size-8 lg:size-10" />
        <div>
          <span
            class="font-newsreader block text-2xl/[110%] font-light lg:text-3xl/[110%]"
            >Ridgeline</span
          >
          <span
            class="font-jetbrains text-2xs/[1] block font-light uppercase lg:text-xs"
            >Architecture Studio</span
          >
        </div>
      </a>
      <div
        class="text-ink font-jetbrains mb-8 space-y-3 text-sm font-light uppercase lg:mb-12 lg:space-y-4 lg:text-base"
      >
        <a href="/project/larch-house" class="uline after:bg-ink block w-max">
          Projects
        </a>
        <a href="/studio" class="uline after:bg-ink block w-max"> Studio </a>
        <button class="group/modal-convo flex cursor-pointer gap-x-3">
          <span
            class="after:bg-ink relative block uppercase after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-bottom-right after:scale-x-0 after:transform after:transition after:duration-300 group-hover/modal-convo:after:origin-bottom-left group-hover/modal-convo:after:scale-x-100 group-focus-visible/modal-convo:after:origin-bottom-left group-focus-visible/modal-convo:after:scale-x-100 data-[active=true]:after:origin-bottom-left data-[active=true]:after:scale-x-100"
          >
            Start a Conversation
          </span>
          <Arrow class="fill-ink w-7 lg:w-9" />
        </button>
      </div>
      <div
        class="font-jetbrains text-ink mb-8 flex gap-x-4 text-xs font-light uppercase lg:mb-12 lg:gap-x-6 lg:text-sm"
      >
        <a href="/" class="uline after:bg-ink">Instagram</a>
        <a href="/" class="uline after:bg-ink">LinkedIn</a>
        <a href="/" class="uline after:bg-ink">Contact</a>
      </div>
      <div
        class="font-jetbrains text-ink text-xs font-light uppercase lg:text-sm"
      >
        <a href="/" class="uline after:bg-ink">(360) 555-0148</a>
        <br /><br />
        <a href="/" class="group/address">
          <span
            class="after:bg-ink relative after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-bottom-right after:scale-x-0 after:transform after:transition after:duration-300 group-hover/address:after:origin-bottom-left group-hover/address:after:scale-x-100 group-focus-visible/address:after:origin-bottom-left group-focus-visible/address:after:scale-x-100 data-[active=true]:after:origin-bottom-left data-[active=true]:after:scale-x-100"
          >
            1420 Alder ridge lane, suite 300
          </span>
          <br />
          <span
            class="after:bg-ink relative after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-bottom-right after:scale-x-0 after:transform after:transition after:delay-150 after:duration-300 group-hover/address:after:origin-bottom-left group-hover/address:after:scale-x-100 group-focus-visible/address:after:origin-bottom-left group-focus-visible/address:after:scale-x-100 data-[active=true]:after:origin-bottom-left data-[active=true]:after:scale-x-100"
          >
            Bellingham, WA 98225
          </span>
        </a>
        <br /><br />
        © 2026 Ridgeline Architecture Studio
      </div>
    </div>
  </div>
</div>

<style>
  /* A closed panel still takes up room inside the link, so move the focus ring
     onto the logo rather than outlining empty space. */
  #nav-home:focus-visible:has(#nav-left-panel:not([data-open])) {
    outline: none;
  }

  #nav-home:focus-visible:has(#nav-left-panel:not([data-open])) #nav-logo {
    outline: auto;
  }
</style>

<script>
  const nav = document.getElementById("nav");
  const scrim = document.getElementById("nav-scrim");
  const menu = document.getElementById("nav-menu");
  // Matches Tailwind's `md` breakpoint, below which only the hamburger is used.
  const mdMql = matchMedia("(min-width: 768px)");
  const leftPanel = document.getElementById("nav-left-panel");
  const rightPanel = document.getElementById("nav-right-panel");
  const hamburgerBtn = document.getElementById("nav-hamburger-btn");

  if (
    nav instanceof HTMLElement &&
    scrim instanceof HTMLDivElement &&
    menu instanceof HTMLDivElement &&
    leftPanel instanceof HTMLDivElement &&
    rightPanel instanceof HTMLDivElement &&
    hamburgerBtn instanceof HTMLButtonElement
  ) {
    // While a page transition runs the left panel stays closed, so that it
    // opens out of the logo once the curtain has shrunk into it, and the nav
    // stays in view for the curtain to shrink into. The right panel only
    // follows the scroll position.
    let transitioning = false;
    // Compared against on each scroll to tell which way the page is moving.
    let lastScrollY = window.scrollY;
    // Freezes the nav's scroll-driven state, so that the hamburger stays in
    // view to close the menu with.
    let menuOpen = false;

    const setOpen = (panel: HTMLElement, open: boolean) => {
      if (panel.hasAttribute("data-open") === open) return;

      panel.toggleAttribute("data-open", open);
    };

    // The hamburger's position is styled off the right panel's `data-open`,
    // so only its focusability needs setting here.
    const setRightOpen = (open: boolean) => {
      setOpen(rightPanel, open);
      // Keeps whichever of the two is hidden out of the tab order. Below `md`
      // the panel isn't displayed and the hamburger always shows.
      rightPanel.inert = !open;
      hamburgerBtn.inert = open && mdMql.matches;
    };

    // Changes elements without their transitions.
    const snap = (elements: HTMLElement[], change: () => void) => {
      elements.forEach((element) => (element.style.transition = "none"));
      change();
      // Flushes the change so the transitions apply again to the next one.
      elements.forEach((element) => {
        element.getBoundingClientRect();
        element.style.transition = "";
      });
    };

    const isAtTop = () => window.scrollY <= 0;

    const setHidden = (hidden: boolean) => {
      nav.toggleAttribute("data-hidden", hidden);
    };

    // Hides the nav while scrolling down, but only once the page has scrolled
    // past the nav itself, so the panels can be seen closing near the top.
    const updateHidden = () => {
      // Clamped because overscroll bounce can report a negative position.
      const scrollY = Math.max(window.scrollY, 0);
      if (scrollY === lastScrollY) return;

      const scrollingDown = scrollY > lastScrollY;
      lastScrollY = scrollY;

      setHidden(scrollingDown && scrollY > nav.offsetTop + nav.offsetHeight);
    };

    window.addEventListener(
      "scroll",
      () => {
        // A resize while the menu is open can move the page and fire this.
        if (menuOpen) {
          lastScrollY = Math.max(window.scrollY, 0);
          return;
        }

        setRightOpen(isAtTop());
        if (transitioning) return;

        setOpen(leftPanel, isAtTop());
        updateHidden();
      },
      { passive: true },
    );

    mdMql.addEventListener("change", () => {
      if (!menuOpen) setRightOpen(isAtTop());
    });

    // Stops the page behind the menu from scrolling, padding out the gap left
    // by a scrollbar that takes up space so the page doesn't shift sideways.
    const setScrollLocked = (locked: boolean) => {
      const scrollbarWidth = locked
        ? window.innerWidth - document.documentElement.clientWidth
        : 0;
      const gap = scrollbarWidth ? `${scrollbarWidth}px` : "";

      document.documentElement.style.overflow = locked ? "hidden" : "";
      document.body.style.paddingRight = gap;
      // The nav is fixed, so body padding doesn't move it.
      nav.style.paddingRight = gap;
    };

    const setMenuOpen = (open: boolean) => {
      menuOpen = open;
      hamburgerBtn.classList.toggle("open", open);
      hamburgerBtn.setAttribute("aria-expanded", String(open));
      scrim.toggleAttribute("data-open", open);
      menu.toggleAttribute("data-open", open);
      // Keeps the closed menu out of the tab order while it stays in the DOM.
      menu.inert = !open;
      setScrollLocked(open);

      if (open) {
        // The nav holds the only way to close the menu again, so it stays in
        // view with the hamburger showing whatever the scroll position and
        // viewport width do next.
        setHidden(false);
        setRightOpen(false);
      } else {
        lastScrollY = Math.max(window.scrollY, 0);
        setRightOpen(isAtTop());
        setOpen(leftPanel, isAtTop());
      }
    };

    hamburgerBtn.addEventListener("click", () => {
      setMenuOpen(hamburgerBtn.getAttribute("aria-expanded") !== "true");
    });

    // Brings the nav back when a keyboard user tabs into it while hidden.
    nav.addEventListener("focusin", () => setHidden(false));

    document.addEventListener("page-transition:covered", () => {
      transitioning = true;
      // Leaves the next page scrollable if a link in the menu was followed.
      setMenuOpen(false);
      snap([leftPanel], () => setOpen(leftPanel, false));
      snap([nav], () => setHidden(false));
    });

    document.addEventListener("page-transition:finished", () => {
      transitioning = false;
      lastScrollY = Math.max(window.scrollY, 0);
      setOpen(leftPanel, isAtTop());
      setRightOpen(isAtTop());
    });

    snap([leftPanel], () => setOpen(leftPanel, isAtTop()));
    snap([rightPanel, hamburgerBtn], () => setRightOpen(isAtTop()));
  }
</script>
