---
import GridCell from "./grid-cell.astro";

import type { GridRow } from "../../data/project-grid";

interface Props {
  row: GridRow;
  index: number;
}

const { row, index } = Astro.props;
---

{
  /* Cells stack below `md`; from there the row is twelve columns and each cell
     places itself with the span and start it was given. `items-start` keeps
     every cell's top on the row's top line. */
}

<div
  class="grid grid-cols-1 items-start gap-x-4 gap-y-4 md:grid-cols-12 lg:gap-x-5 lg:gap-y-5"
>
  {row.cells.map((cell, i) => <GridCell cell={cell} slot={`${index}-${i}`} />)}
</div>
