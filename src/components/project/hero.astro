---
import { Image } from "astro:assets";

import { type Project } from "../../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{
  /* The image keeps the same `<Image>` options as the homepage thumbnail so
     both resolve to the same URL, which is already cached and decoded by the
     time the expanding thumbnail hands over to it. */
}

<section class="relative z-10 h-screen max-h-224 w-full">
  <Image
    id="project-hero-image"
    src={project.img.src}
    alt={project.img.alt}
    loading="eager"
    class="h-full w-full object-cover"
  />
  <div class="bg-ink/60 absolute top-0 left-0 h-full w-full"></div>
  {
    /* `text-box` trims the space the line-height leaves under each last line,
       so the title and caption boxes both end on their text's baseline and
       their bottoms line up. Baseline alignment gives the same result for the
       text alone in browsers that don't support `text-box`. */
  }
  <div
    class="absolute top-0 left-1/2 h-full w-full -translate-x-1/2 px-5 sm:px-8 lg:px-10"
  >
    <div
      class="mx-auto flex h-full w-full max-w-344 flex-col justify-end gap-y-4 pb-10 md:flex-row md:items-baseline-last md:justify-between md:gap-x-10 xl:pb-16"
    >
      <h1
        class="font-newsreader text-alabaster text-6xl/[110%] font-light [text-box:trim-end_cap_alphabetic] md:text-7xl/[110%] lg:text-8xl/[110%]"
      >
        {project.title}
      </h1>
      <p
        class="font-newsreader text-alabaster/85 xs:text-base 2xs:text-sm shrink-0 text-xs italic [text-box:trim-end_cap_alphabetic] md:text-end"
      >
        {project.title}. {project.location}.<br class="lg:hidden" /> Completed {
          project.year
        }.
      </p>
    </div>
  </div>
</section>
