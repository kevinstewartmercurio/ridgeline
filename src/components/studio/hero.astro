---
import { Image } from "astro:assets";

import heroImage from "../../images/studio/hero.png";
---

<section class="relative z-10 h-screen max-h-224 w-full">
  <Image src={heroImage} alt="" class="h-full w-full object-cover" />
  <div
    class="absolute top-0 left-1/2 h-full w-full -translate-x-1/2 px-5 sm:px-8 lg:px-10"
  >
    <div class="mx-auto flex h-full w-full max-w-344 items-end pb-10 xl:pb-16">
      <h1
        class="font-newsreader text-alabaster text-4xl/[110%] font-light sm:text-5xl/[110%] md:text-6xl/[110%] lg:text-7xl/[110%] xl:text-8xl/[110%] 2xl:text-9xl/[110%]"
      >
        An architect-led practice,
        <br class="hidden sm:block" />
        deliberately small.
      </h1>
    </div>
  </div>
</section>
