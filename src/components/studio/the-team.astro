---
import { Image } from "astro:assets";
import Logo from "../logo.astro";

import marenOstbergImage from "../../images/studio/maren-ostberg.png";
import danielReyesImage from "../../images/studio/daniel-reyes.png";
import irisNakamuraImage from "../../images/studio/iris-nakamura.png";
import priyaAnandImage from "../../images/studio/priya-anand.png";
import callumSorensenImage from "../../images/studio/callum-sorensen.png";
import tomWhitlockImage from "../../images/studio/tom-whitlock.png";

const team = [
  {
    name: "Maren Ostberg",
    title: "Founding Partner, Architect",
    src: marenOstbergImage,
  },
  {
    name: "Daniel Reyes",
    title: "Partner, Design-Build",
    src: danielReyesImage,
  },
  {
    name: "Iris Nakamura",
    title: "Director of Interiors",
    src: irisNakamuraImage,
  },
  {
    name: "Priya Anand",
    title: "Project Architect",
    src: priyaAnandImage,
  },
  {
    name: "Callum Sørensen",
    title: "Site & Materials Lead",
    src: callumSorensenImage,
  },
  {
    name: "Tom Whitlock",
    title: "Construction Administration",
    src: tomWhitlockImage,
  },
];
---

<section
  class="bg-pine relative z-10 w-full px-5 py-16 sm:px-8 sm:pt-20 md:pt-26 md:pb-24 lg:px-10"
>
  <div class="mx-auto w-full max-w-344">
    {
      /* The heading and then each member rise as they reach the viewport, a
         member at a time rather than the grid as one piece, since the grid is
         several screens tall. See `reveal.astro`. */
    }
    <div data-reveal>
      <h2
        class="text-alabaster font-newsreader 2xs:text-6xl flex w-full justify-between text-5xl font-light md:text-7xl lg:text-8xl"
      >
        <span>The</span>
        <span>Team</span>
      </h2>
      <hr class="border-alabaster w-full" />
    </div>
    <div
      class="grid grid-cols-2 gap-x-3 gap-y-12 pt-10 sm:gap-y-16 md:grid-cols-3 lg:gap-x-5 lg:gap-y-24"
    >
      {
        team.map((member) => (
          <div data-reveal class="member relative">
            <Image
              src={member.src}
              alt={`${member.name}, ${member.title}`}
              class="mb-4 aspect-square w-full object-cover"
            />
            <h3 class="font-newsreader text-alabaster xs:text-2xl text-xl font-light lg:mb-1.5 lg:text-3xl">
              {member.name}
            </h3>
            <span class="text-alabaster font-jetbrains text-2xs block uppercase lg:text-xs">
              {member.title}
            </span>
            <div class="bg-alabaster member-logo xs:size-12 absolute top-2.5 right-2.5 flex size-10 origin-top-right scale-0 items-center justify-center duration-300 sm:size-14 md:size-10 lg:size-12 xl:size-20">
              <Logo class="fill-pine size-[75%]" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const init = () => {
    const teamMembers = document.querySelectorAll(".member");
    const memberLogos = document.querySelectorAll(".member-logo");

    // `astro:page-load` runs this again after every navigation, so the
    // listeners below are dropped as the members they belong to go away.
    const controller = new AbortController();
    const { signal } = controller;

    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });

    teamMembers.forEach((member, idx) => {
      member.addEventListener(
        "mouseenter",
        () => {
          if (memberLogos[idx] instanceof HTMLDivElement) {
            memberLogos[idx].classList.replace("scale-0", "scale-100");
          }
        },
        { signal },
      );

      member.addEventListener(
        "mouseleave",
        () => {
          if (memberLogos[idx] instanceof HTMLDivElement) {
            memberLogos[idx].classList.replace("scale-100", "scale-0");
          }
        },
        { signal },
      );
    });
  };

  document.addEventListener("astro:page-load", init);
</script>
