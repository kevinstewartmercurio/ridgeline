---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Lenis from "../components/lenis.astro";
import Nav from "../components/nav.astro";
import PageTransition from "../components/page-transition.astro";
import ProjectTransition from "../components/project-transition.astro";

import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--newsreader" preload />
    <Font cssVariable="--jetbrains-mono" preload />
    <Font cssVariable="--instrument-sans" preload />
    <ClientRouter />
  </head>
  <body>
    <Lenis />
    <Nav />
    <slot />
    <ProjectTransition />
    <PageTransition />
  </body>
</html>

<style is:global>
  .uline {
    position: relative;
  }

  .uline::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    width: 100%;
    transform-origin: bottom right;
    transform: scaleX(0);
    /* background: var(--color-alabaster); */
    /* Tailwind's `transition` easing and `duration-300`. */
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Swapping the origin makes the underline wipe out the way it came in. */
  .uline:hover::after,
  .uline:focus-visible::after,
  .uline[data-active="true"]::after {
    transform-origin: bottom left;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .uline::after {
      transition: none;
    }
  }
</style>
